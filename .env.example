# ==============================================================================
# ALANKRITI COUTURE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and configure your credentials.
# Never commit `.env` containing sensitive credentials to public source control.
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for AWS RDS / Supabase / Neon:
# DATABASE_URL="postgresql://user:password@host:5432/alankriti_db?schema=public&sslmode=require"

# Client Authentication JWT Secret (HMAC-SHA256)
JWT_SECRET="replace-with-a-secure-random-secret-key-for-customer-auth"

# Administrative Vault JWT Secret (Separate high-security token key)
ADMIN_JWT_SECRET="replace-with-a-distinct-high-entropy-secret-key-for-admin-auth"

# Initial Development Admin Credentials (used during DB seeding and initial bootstrap)
ADMIN_USERNAME="admin@alankriticouture.com"
ADMIN_PASSWORD="AlankritiAdmin@2026"

# Razorpay Payment Gateway Credentials (Test or Production API Keys)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_ALANKRITI2026"
RAZORPAY_KEY_SECRET="ALANKRITI_SECRET_KEY_2026"
RAZORPAY_WEBHOOK_SECRET="ALANKRITI_WEBHOOK_SECRET_2026"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
